{
  "name": "wasm-tools-setup",
  "version": "1.1.3",
  "description": "GitHub Action to install wasm-tools and add it to the PATH",
  "scripts": {
    "build": "tsc && ncc build -o dist src/index.ts",
    "format": "prettier --write '**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/wasm-tools-setup.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "wasmtime"
  ],
  "author": "step-security",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1",
    "@octokit/rest": "^19.0.7",
    "@types/fs-extra": "^11.0.1",
    "@types/uuid": "^9.0.1",
    "axios": "^1.9.0",
    "fs-extra": "^11.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.0",
    "@vercel/ncc": "^0.36.1",
    "prettier": "2.8.4",
    "typescript": "^4.9.5"
  }
}
